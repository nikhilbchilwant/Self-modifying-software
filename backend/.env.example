# =============================================================================
# Creator Sandbox — Backend Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# The backend reads this file automatically via `dotenv` on startup.
# Do not commit your real `.env` file.
# =============================================================================

# -----------------------------------------------------------------------------
# AI Provider (required for sandbox modifications)
# -----------------------------------------------------------------------------
# Default demo configuration: OpenRouter free Tencent model.
# Get an OpenRouter key from https://openrouter.ai/keys and paste it into `.env`.
PI_AI_PROVIDER=openrouter
PI_AI_MODEL=tencent/hy3:free
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Other supported providers can be used by changing PI_AI_PROVIDER, PI_AI_MODEL,
# and the matching provider key env var. Examples:
#   GEMINI_API_KEY=your_gemini_api_key_here
#   ANTHROPIC_API_KEY=your_anthropic_api_key_here
#   OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=5000
